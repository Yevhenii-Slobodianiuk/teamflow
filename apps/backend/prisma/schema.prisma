generator client {
  provider = "prisma-client"
	output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. ENUMS
// ==========================================
enum UserStatus {
  ONLINE
  IDLE
  DND
  OFFLINE
}
enum MemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}
enum ChannelType {
  TEXT
  VOICE
  ANNOUNCEMENT
}
enum FileType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

// ==========================================
// 2. MODELS 
// ==========================================
model User {
  id           String     @id @default(uuid())
  email        String     @unique
  username     String     @unique
  displayName  String
  passwordHash String
  avatarUrl    String?
  bio          String?
  status       UserStatus @default(OFFLINE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  // Реляції
  refreshTokens   RefreshToken[]
  memberships     WorkspaceMember[]
  ownedWorkspaces Workspace[]           @relation("WorkspaceOwner")
  messages        Message[]             @relation("MessageAuthor")
  directMessages  DirectMessage[]       @relation("DirectMessageAuthor")
  directChannels  UserDirectChannel[]
  reactions       Reaction[]
  @@map("users")
}
model RefreshToken {
  id          String   @id @default(uuid())
  hashedToken String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())
  @@index([userId])
  @@map("refresh_tokens")
}
model Workspace {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  iconUrl     String?
  inviteCode  String   @unique @default(uuid())
  ownerId     String
  owner       User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members  WorkspaceMember[]
  channels Channel[]
  @@map("workspaces")
}
model WorkspaceMember {
  id          String     @id @default(uuid())
  role        MemberRole @default(MEMBER)
  nickname    String?
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  joinedAt    DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}
model Channel {
  id          String      @id @default(uuid())
  name        String
  topic       String?
  type        ChannelType @default(TEXT)
  isPrivate   Boolean     @default(false)
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  messages Message[]
  @@index([workspaceId])
  @@map("channels")
}
model Message {
  id        String    @id @default(uuid())
  content   String
  isPinned  Boolean   @default(false)
  deletedAt DateTime?
  channelId String
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  attachments Attachment[]
  reactions   Reaction[]
  @@index([channelId, createdAt])
  @@map("messages")
}
model DirectMessageChannel {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  participants UserDirectChannel[]
  messages     DirectMessage[]
  @@map("direct_message_channels")
}
model UserDirectChannel {
  id              String               @id @default(uuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  directChannelId String
  directChannel   DirectMessageChannel @relation(fields: [directChannelId], references: [id], onDelete: Cascade)
  joinedAt        DateTime             @default(now())
  @@unique([userId, directChannelId])
  @@index([userId])
  @@index([directChannelId])
  @@map("user_direct_channels")
}
model DirectMessage {
  id              String               @id @default(uuid())
  content         String
  isPinned        Boolean              @default(false)
  deletedAt       DateTime?
  directChannelId String
  directChannel   DirectMessageChannel @relation(fields: [directChannelId], references: [id], onDelete: Cascade)
  authorId        String
  author          User                 @relation("DirectMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  attachments Attachment[]
  reactions   Reaction[]
  @@index([directChannelId, createdAt])
  @@map("direct_messages")
}
model Attachment {
  id              String         @id @default(uuid())
  fileUrl         String
  fileName        String
  fileType        FileType       @default(OTHER)
  fileSize        Int
  mimeType        String
  messageId       String?
  message         Message?       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  directMessageId String?
  directMessage   DirectMessage? @relation(fields: [directMessageId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  @@index([messageId])
  @@index([directMessageId])
  @@map("attachments")
}
model Reaction {
  id              String         @id @default(uuid())
  emoji           String
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId       String?
  message         Message?       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  directMessageId String?
  directMessage   DirectMessage? @relation(fields: [directMessageId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  @@unique([userId, messageId, emoji])
  @@index([messageId])
  @@index([directMessageId])
  @@map("reactions")
}